; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Demake86"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=300
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1024
window/size/viewport_height=1024
window/size/transparent=true
window/stretch/scale=8.0
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0
window/snap/snap_2d_transforms_to_pixel=false

[editor]

movie_writer/video_quality=1.0
movie_writer/ogv/encoding_speed=3
movie_writer/ogv/keyframe_interval=16
movie_writer/movie_file="/home/lynn/proj/demake86/z_ExportedMovies/out.avi"
movie_writer/fps=120
movie_writer/mjpeg_quality=0.9

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_sfxr/plugin.cfg", "res://addons/levelshot/plugin.cfg", "res://addons/sceneshot/plugin.cfg", "res://addons/vertex_painter/plugin.cfg")

[global_group]

player=""
enemies=""
beam=""
hatch=""
bomb="Morph ball bomb"
water=""

