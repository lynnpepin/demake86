[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_ai8r7"]
output_port_for_preview = 0
size = Vector2(840, 1100)
expression = "// Dithering ??

float steps = 4.0;

ivec2 px = ivec2(FRAGCOORD.xy);
int bx = px.x % 4;
int by = px.y % 4;

float m[16] = float[](
     0.0,  8.0,  2.0, 10.0,
    12.0,  4.0, 14.0,  6.0,
     3.0, 11.0,  1.0,  9.0,
    15.0,  7.0, 13.0,  5.0
);
float threshold = m[by * 4 + bx] / 16.0;
float dithered = value + (threshold - 0.5) / steps;
q = clamp(floor(dithered * steps + 0.5) / steps, 0.0, 1.0);
"

