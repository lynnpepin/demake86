[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_jngj8"]
output_port_for_preview = 0
size = Vector2(860, 1160)
expression = "float maxR = 256.0;
float steps = 8.0;

// normalize uvlen in range [0, maxR]
uvlen = uvlen * maxR;

// linear equation controls pinhole
output = - (maxR/R)*uvlen + maxR;

// normalize [0, 256] to [0, 1]
output = 1.0 - output / maxR;

// finally, for the first 25% of maxR, fade in
// (e.g. pairs (0, 0), (16, .25), (64, 1.0))
float alpha_fade_in = min(
  (maxR - R) 
    * 4.0    // So it only takes the first 25%
    / maxR,  // Normalize to 1.0
  1.0        // clip at 1.0
);
output = output * alpha_fade_in;

// divide into steps
// todo; dithering preferred
//output = round(output * steps) / steps;"

