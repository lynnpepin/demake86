[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_jngj8"]
output_port_for_preview = 0
size = Vector2(860, 1500)
expression = "// wait. what was R and uvlen
// fuuuck


// norm-R; should be 1/2 width
float nR = 256.0;

// Normalize to range [0, nR]. (nR*1.414 on corners)
// uvlen is [0, .5] by default, .717 on corners
// uvlen * 2.0 brings us to [0, 1.0]
// * nR brings us to [0, nR]
uvlen = uvlen * nR * 2.0;

// linear equation to control pinhole:
// y = mx + b
// where b = nR
// x = uvlen
// and m is variable with radius, against nR
// so, perfect linear when R = nR
output = - (nR/R) * uvlen + nR;

// remove negative values
//output = max(0.0, output)
// fix values >1 at corners
//output = min(1.0, output)

// now re-normalize from [0, nR] to [0, 1]
output = 1.0 - output / nR;
"

