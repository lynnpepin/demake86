[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_ht3vd"]
output_port_for_preview = 0
size = Vector2(1020, 1280)
expression = "vec3 result;
float t = mod(time, 1.0)*2.0;
t = mod(t, 1.0);

vec3 blue = vec3(0.639, 0.855, 0.992);
//	float(0x5b)/255.0, float(0xCF)/255.0, float(0xFB)/255.0)
vec3 white = vec3(1.0, 1.0, 1.0);
vec3 pink = vec3(0.969, 0.804, 0.925);
//	float(0xF5)/255.0, float(0xAb)/255.0, float(0xB9)/255.0)

if (t < 0.333) result = mix(blue, white, t/0.333);
else if (t < 0.666) result = mix(white, pink, (t-0.333)/.333);
else result = mix(pink, blue, (t-0.666)/.333);
//if (t < 0.125) result = mix(blue, white, _mix_ratio);
//else if (t < 0.125) result = mix(pink, white, _mix_ratio);

color = result;
//color = vec3(1.0, 0.0, 1.0);"

